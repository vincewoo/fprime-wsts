@ Where this vehicle places the subtopologies it uses. The configuration overrides in the
@ directory above take their base IDs from here.
module MissionIds {

  @ Base ID of the CdhCore subtopology on the Cdh computer
  constant CDH_CORE = 0x05000000

  @ Base ID of the SensorLink subtopology on the Cdh computer
  constant SENSOR_LINK = 0x06000000

}
