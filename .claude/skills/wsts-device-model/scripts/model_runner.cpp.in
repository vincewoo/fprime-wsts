// ======================================================================
// model_runner.cpp: generated by conform.py from model_runner.cpp.in. Do not edit.
//
// Puts one device model on the WSTS bus, outside any F Prime build, and drives it from
// JSON lines on stdin, one result line per op on stdout. Only Wsts/Core is linked, so a
// model compiles here in seconds. The ops are what flight software does through a
// surrogate (send bytes, an I2C transaction, a register read, ...), plus the simulation's
// own (a tick, a parameter); conform.py turns hardware captures into these ops.
//
//   {"op":"set","key":k,"value":v}                  -> ok
//   {"op":"attach","kind":K,"endpoint":e,"addr":a}  -> the model becomes the device on e
//   {"op":"bind","kind":K,"endpoint":e}             -> watch what the model sends on e
//   {"op":"tick","n":n}                             -> n calls of onTick
//   {"op":"tx","endpoint":e,"data":hex}             -> status
//   {"op":"i2c","endpoint":e,"addr":a,"write":hex,"rlen":n} -> status, read
//   {"op":"spi","endpoint":e,"write":hex,"rlen":n}  -> status, read
//   {"op":"gpio_write","endpoint":e,"level":b}      -> status
//   {"op":"gpio_read","endpoint":e}                 -> status, level
//   {"op":"reg_rd","endpoint":e,"offset":o,"width":w}          -> status, value
//   {"op":"reg_wr","endpoint":e,"offset":o,"width":w,"value":v} -> status
//   {"op":"drain"}  -> "rx.<endpoint>": hex for each byte stream, "gpio_in": "e=1;e=0",
//                      "irq": "e:1;e:3" ; everything the model sent since the last drain
// ======================================================================
#include <Wsts/Core/Bus.hpp>
#include <Wsts/Core/Control.hpp>
#include <Wsts/Core/Json.hpp>

#include <@HEADER@>

#include <cstdint>
#include <iostream>
#include <map>
#include <memory>
#include <mutex>
#include <string>
#include <type_traits>

namespace {

using ModelType = @CLASS@;

std::mutex g_mutex;
std::map<std::string, Wsts::Bytes> g_rx;
std::string g_gpioIn;
std::string g_irq;

void append(std::string& list, const std::string& item) {
    if (!list.empty()) {
        list += ";";
    }
    list += item;
}

void bindFlightSide(const std::string& kind, const std::string& endpoint) {
    Wsts::Bus& bus = Wsts::Bus::get();
    if (kind == "bytestream") {
        bus.bindByteStream(endpoint, [endpoint](const Wsts::Bytes& data) {
            std::lock_guard<std::mutex> lock(g_mutex);
            Wsts::Bytes& rx = g_rx[endpoint];
            rx.insert(rx.end(), data.begin(), data.end());
        });
    } else if (kind == "gpio") {
        bus.bindGpio(endpoint, [endpoint](bool level) {
            std::lock_guard<std::mutex> lock(g_mutex);
            append(g_gpioIn, endpoint + "=" + (level ? "1" : "0"));
        });
    } else if (kind == "register") {
        bus.bindRegister(endpoint, [endpoint](std::uint32_t number) {
            std::lock_guard<std::mutex> lock(g_mutex);
            append(g_irq, endpoint + ":" + std::to_string(number));
        });
    }
}

template <typename T>
bool attach(T* model, const std::string& kind, const std::string& endpoint, std::uint32_t addr, std::string& error) {
    Wsts::Bus& bus = Wsts::Bus::get();
    if (kind == "bytestream") {
        if constexpr (std::is_base_of<Wsts::ByteStreamDevice, T>::value) {
            bus.attachByteStream(endpoint, model);
            return true;
        }
    } else if (kind == "i2c") {
        if constexpr (std::is_base_of<Wsts::I2cDevice, T>::value) {
            bus.attachI2c(endpoint, addr, model);
            return true;
        }
    } else if (kind == "spi") {
        if constexpr (std::is_base_of<Wsts::SpiDevice, T>::value) {
            bus.attachSpi(endpoint, model);
            return true;
        }
    } else if (kind == "gpio") {
        if constexpr (std::is_base_of<Wsts::GpioDevice, T>::value) {
            bus.attachGpio(endpoint, model);
            return true;
        }
    } else if (kind == "register") {
        if constexpr (std::is_base_of<Wsts::RegisterDevice, T>::value) {
            (void)bus.attachRegister(endpoint, model);
            return true;
        }
    } else if (kind == "none") {
        return true;
    }
    error = "the model does not implement the " + kind + " interface";
    return false;
}

}  // namespace

int main() {
    std::unique_ptr<ModelType> model(new ModelType());
    Wsts::Bus& bus = Wsts::Bus::get();
    std::uint64_t tick = 0;
    std::string line;
    std::cout << std::unitbuf;
    while (std::getline(std::cin, line)) {
        if (line.empty() || line[0] == '#') {
            continue;
        }
        Wsts::JsonObj in;
        Wsts::JsonObj out;
        std::string error;
        if (!in.parse(line, error)) {
            out.setBool("ok", false).set("error", error);
            std::cout << out.dump() << "\n";
            continue;
        }
        const std::string op = in.str("op");
        const std::string endpoint = in.str("endpoint", "dev");
        bool ok = true;
        if (op == "set") {
            ok = Wsts::configureModel(model.get(), in.str("key"), in.str("value"));
            if (!ok) {
                error = "model rejected " + in.str("key") + "=" + in.str("value");
            }
        } else if (op == "attach") {
            const std::string kind = in.str("kind");
            ok = attach(model.get(), kind, endpoint, static_cast<std::uint32_t>(in.num("addr")), error);
            if (ok) {
                bindFlightSide(kind, endpoint);
            }
        } else if (op == "bind") {
            bindFlightSide(in.str("kind"), endpoint);
        } else if (op == "tick") {
            const std::int64_t n = in.num("n", 1);
            for (std::int64_t i = 0; i < n; i++) {
                tick++;
                if constexpr (std::is_base_of<Wsts::Model, ModelType>::value) {
                    model->onTick(tick);
                }
            }
            out.setNum("tick", static_cast<std::int64_t>(tick));
        } else if (op == "tx") {
            Wsts::Bytes data;
            ok = Wsts::fromHex(in.str("data"), data);
            if (ok) {
                out.setNum("status", bus.byteStreamSend(endpoint, data));
            } else {
                error = "bad hex";
            }
        } else if (op == "i2c" || op == "spi") {
            Wsts::Bytes write;
            ok = Wsts::fromHex(in.str("write"), write);
            Wsts::Bytes read(static_cast<std::size_t>(in.num("rlen", 0)));
            if (ok) {
                const int status = op == "i2c"
                                       ? bus.i2cTransact(endpoint, static_cast<std::uint32_t>(in.num("addr")), write, read)
                                       : bus.spiTransfer(endpoint, write, read);
                out.setNum("status", status).set("read", Wsts::toHex(read));
            } else {
                error = "bad hex";
            }
        } else if (op == "gpio_write") {
            out.setNum("status", bus.gpioWrite(endpoint, in.flag("level")));
        } else if (op == "gpio_read") {
            bool level = false;
            out.setNum("status", bus.gpioRead(endpoint, level)).setBool("level", level);
        } else if (op == "reg_rd") {
            std::uint64_t value = 0;
            const int status = bus.registerRead(endpoint, in.unum("offset"), static_cast<unsigned>(in.num("width", 4)), value);
            out.setNum("status", status).setHex("value", value);
        } else if (op == "reg_wr") {
            out.setNum("status", bus.registerWrite(endpoint, in.unum("offset"), static_cast<unsigned>(in.num("width", 4)),
                                                   in.unum("value")));
        } else if (op == "drain") {
            std::lock_guard<std::mutex> lock(g_mutex);
            for (auto& entry : g_rx) {
                out.set("rx." + entry.first, Wsts::toHex(entry.second));
                entry.second.clear();
            }
            out.set("gpio_in", g_gpioIn).set("irq", g_irq);
            g_gpioIn.clear();
            g_irq.clear();
        } else {
            ok = false;
            error = "unknown op " + op;
        }
        out.setBool("ok", ok);
        if (!ok) {
            out.set("error", error);
        }
        std::cout << out.dump() << "\n";
    }
    return 0;
}
